# クラッシュロワイヤル公式APIのトークン
# developer.clashroyale.com で発行する。許可IPには 45.79.218.79 を指定すること。
# 改行を入れず1行で記述する。取得手順は docs/setup-api-token.md を参照。
CR_API_TOKEN=

# 自分のプレイヤータグ。# を付けたまま記述する。
# ゲーム内のプロフィール画面で確認できる。O（オー）は使われず 0（ゼロ）である点に注意。
CR_PLAYER_TAG=#XXXXXXXX

# RoyaleAPIのプロキシを経由するか。
# true  : proxy.royaleapi.dev 経由（推奨。自宅のIP変動の影響を受けない）
# false : api.clashroyale.com へ直接アクセス（許可IPに自分のIPの登録が必要）
CR_USE_PROXY=true
